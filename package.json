{
  "name": "kasina",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:seed": "pnpm --filter @kasina/db seed",
    "db:reset-pilot": "pnpm --filter @kasina/db reset-pilot",
    "questions:validate": "pnpm --filter @kasina/question-bank validate",
    "smoke:prod": "bash ./scripts/smoke-prod.sh",
    "textbooks:upload": "bash ./scripts/upload-textbooks-r2.sh"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
